import "time/DateTime.tzd";

fun testPrimes(limit) {
    
    var sw = new Stopwatch();
    sw.start();
    var sieve = range(0, limit, 1);
    sw.stop();
    print("Loop 1 (range): " + toString(sw.elapsedMs()) + " ms");
    
    sw.reset();
    sw.start();
    var i = 0;
    while (i < limit) {
        sieve[i] = true;
        i = i + 1;
    }
    sw.stop();
    print("Loop 2 (init true): " + toString(sw.elapsedMs()) + " ms");
    
    sieve[0] = false;
    sieve[1] = false;
    
    sw.reset();
    sw.start();
    var p = 2;
    while (p * p < limit) {
        if (sieve[p]) {
            var m = p * p;
            while (m < limit) {
                sieve[m] = false;
                m = m + p;
            }
        }
        p = p + 1;
    }
    sw.stop();
    print("Loop 3 (sieve inner): " + toString(sw.elapsedMs()) + " ms");
    
    sw.reset();
    sw.start();
    var count = 0;
    var k = 0;
    while (k < limit) {
        if (sieve[k]) {
            count = count + 1;
        }
        k = k + 1;
    }
    sw.stop();
    print("Loop 4 (count): " + toString(sw.elapsedMs()) + " ms, count=" + toString(count));
    return count;
}

testPrimes(1000000);
