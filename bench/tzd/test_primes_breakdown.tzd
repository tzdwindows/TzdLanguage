import "time/DateTime.tzd";

fun testBreakdown(limit) {
    var sw = new Stopwatch();

    sw.start();
    var sieve = range(0, limit, 1);
    sw.stop();
    print("range: " + toString(sw.elapsedMs()) + " ms");

    sw.start();
    var i = 0;
    while (i < limit) {
        sieve[i] = true;
        i = i + 1;
    }
    sw.stop();
    print("init sieve: " + toString(sw.elapsedMs()) + " ms");

    sw.start();
    sieve[0] = false;
    sieve[1] = false;
    var p = 2;
    while (p * p < limit) {
        if (sieve[p]) {
            var m = p * p;
            while (m < limit) {
                sieve[m] = false;
                m = m + p;
            }
        }
        p = p + 1;
    }
    sw.stop();
    print("sieve inner: " + toString(sw.elapsedMs()) + " ms");

    sw.start();
    var count = 0;
    var k = 0;
    while (k < limit) {
        if (sieve[k]) {
            count = count + 1;
        }
        k = k + 1;
    }
    sw.stop();
    print("count: " + toString(sw.elapsedMs()) + " ms");

    return count;
}

testBreakdown(1000000);
