import "time/DateTime.tzd";

// Partition-only (no recursion): isolate the partition loop cost
var P = range(0, 300000, 1);
fun fillP(n) {
    var x = 1;
    var i = 0;
    while (i < n) {
        x = (x * 16807) % 2147483647;
        P[i] = x % 1000000007;
        i = i + 1;
    }
    return 0;
}
fun partitionOnly(lo, hi) {
    if (lo >= hi) { return 0; }
    var p = P[hi];
    var i = lo - 1;
    var j = lo;
    while (j < hi) {
        if (P[j] <= p) {
            i = i + 1;
            var t = P[i];
            P[i] = P[j];
            P[j] = t;
        }
        j = j + 1;
    }
    i = i + 1;
    var t2 = P[i];
    P[i] = P[hi];
    P[hi] = t2;
    return i;
}

var sw0 = new Stopwatch();
sw0.start();
fillP(300000);
sw0.stop();
print("fillP | " + toString(sw0.elapsedMs()) + " ms");

// One partition over the full range
var sw1 = new Stopwatch();
sw1.start();
partitionOnly(0, 299999);
sw1.stop();
print("partitionOnly(0,299999) | " + toString(sw1.elapsedMs()) + " ms");

// Recursive qsort (same as benchmark)
var Q = range(0, 300000, 1);
fun qsortG(lo, hi) {
    if (lo >= hi) { return 0; }
    var p = Q[hi];
    var i = lo - 1;
    var j = lo;
    while (j < hi) {
        if (Q[j] <= p) {
            i = i + 1;
            var t = Q[i];
            Q[i] = Q[j];
            Q[j] = t;
        }
        j = j + 1;
    }
    i = i + 1;
    var t2 = Q[i];
    Q[i] = Q[hi];
    Q[hi] = t2;
    qsortG(lo, i - 1);
    qsortG(i + 1, hi);
    return 0;
}
fun quickSort() {
    var n = 300000;
    var x = 1;
    var fillSum = 0;
    var i = 0;
    while (i < n) {
        x = (x * 16807) % 2147483647;
        var v = x % 1000000007;
        Q[i] = v;
        fillSum = fillSum + v;
        i = i + 1;
    }
    qsortG(0, n - 1);
    print("qsort min=" + toString(Q[0]) + " max=" + toString(Q[n - 1]) + " fill=" + toString(fillSum));
    return 0;
}

var sw2 = new Stopwatch();
sw2.start();
quickSort();
sw2.stop();
print("quickSort | " + toString(sw2.elapsedMs()) + " ms");

print("=== probe_part done ===");
