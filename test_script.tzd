import "core/Error.tzd";

fun runDemo() {
    try {
        throw new Error("test error", "TEST");
    } catch (err) {
        print("caught: " + err.code + " " + err.message);
    }
}
runDemo();

class Animal {
    var string name;
    Animal(name) { this.name = name; }
    fun speak() { print(this.name + " says ..."); }
}
class Dog extends Animal {
    Dog(name) : super(name) {}
    fun speak() { print(this.name + " barks! woof!"); }
}

fun testOop() {
    var d = new Dog("Buddy");
    d.speak();
    if (d in Dog) print("d is a Dog");
    if (d in Animal) print("d is also an Animal");
}
testOop();
exit
