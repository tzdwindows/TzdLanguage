{
    "name": "tzdlang",
    "displayName": "TzdLang",
    "description": "现代化、高性能面向对象编程语言 TzdLang 官方插件，支持语法高亮、LSP代码补全、DAP可视化交互断点调试",
    "version": "0.2.16",
    "publisher": "tzdwindows7",
    "repository": {
        "type": "git",
        "url": "https://github.com/tzdwindows/TzdLanguage"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages",
        "Debuggers"
    ],
    "activationEvents": [
        "onLanguage:tzdlang",
        "onDebug:tzdlang",
        "onDebug:tzd",
        "onCommand:tzdlang.runCurrentFile",
        "onCommand:tzdlang.debugCurrentFile",
        "onCommand:tzdlang.resetToolsPath",
        "onCommand:tzdlang.showJitStatus",
        "onCommand:tzdlang.listJitFunctions",
        "onCommand:tzdlang.dumpJitIR",
        "onCommand:tzdlang.helloWorld"
    ],
    "main": "./extension.js",
    "contributes": {
        "languages": [
            {
                "id": "tzdlang",
                "aliases": [
                    "TzdLang",
                    "tzdlang"
                ],
                "extensions": [
                    ".tzd",
                    ".tzdlang"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "tzdlang",
                "scopeName": "source.tzdlang",
                "path": "./syntaxes/tzdlang.tmLanguage.json"
            }
        ],
        "breakpoints": [
            {
                "language": "tzdlang"
            }
        ],
        "debuggers": [
            {
                "type": "tzdlang",
                "label": "TzdLang 调试器",
                "languages": [
                    "tzdlang"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "要运行和调试的 .tzd 脚本绝对路径或工作区相对路径。",
                                "default": "${file}"
                            },
                            "jit": {
                                "type": "boolean",
                                "description": "是否开启 JIT 即时编译极速执行 (默认 true，零运行时开销)。",
                                "default": true
                            },
                            "optLevel": {
                                "type": "number",
                                "enum": [0, 1, 2, 3],
                                "description": "JIT 优化级别: 0 (无内联), 1 (轻度), 2 (标准平衡), 3 (极限内联与循环展开)。",
                                "default": 3
                            },
                            "inlineThreshold": {
                                "type": "number",
                                "description": "JIT 函数内联阈值 (例如 500)。",
                                "default": 500
                            },
                            "enableAstInlining": {
                                "type": "boolean",
                                "description": "是否开启 AST 级小函数极速内联 (大幅消除函数调用装箱开销)。",
                                "default": true
                            },
                            "enableMathIntrinsics": {
                                "type": "boolean",
                                "description": "是否开启内置数学函数硬件指令级内联 (如 sqrt -> sqrtsd)。",
                                "default": true
                            },
                            "enableLoopUnroll": {
                                "type": "boolean",
                                "description": "是否开启循环展开优化 (Loop Unrolling)。",
                                "default": true
                            },
                            "args": {
                                "type": "array",
                                "description": "传递给 TzdTools.exe 的额外命令行启动参数 (例如 [\"--jit-debug\", \"-O3\", \"--bigTime\"])。",
                                "items": {
                                    "type": "string"
                                },
                                "default": [
                                    "--jit",
                                    "--jit-debug",
                                    "-O3"
                                ]
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "是否在程序启动入口第一行暂停。",
                                "default": false
                            },
                            "cwd": {
                                "type": "string",
                                "description": "脚本运行工作目录。",
                                "default": "${workspaceFolder}"
                            },
                            "debugPort": {
                                "type": "number",
                                "description": "TzdTools 调试服务器端口 (默认 54321)。",
                                "default": 54321
                            },
                            "debugHost": {
                                "type": "string",
                                "description": "TzdTools 调试服务器主机地址 (默认 127.0.0.1)。",
                                "default": "127.0.0.1"
                            },
                            "toolsPath": {
                                "type": "string",
                                "description": "自定义 TzdTools.exe 路径，留空则自动检测。",
                                "default": ""
                            }
                        }
                    },
                    "attach": {
                        "properties": {
                            "debugPort": {
                                "type": "number",
                                "description": "目标 TzdTools 调试服务器端口 (例如 54321)。",
                                "default": 54321
                            },
                            "debugHost": {
                                "type": "string",
                                "description": "目标 TzdTools 调试服务器主机地址。",
                                "default": "127.0.0.1"
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "name": "TzdLang: JIT 极限性能调试 (-O3 极限内联与循环展开)",
                        "type": "tzdlang",
                        "request": "launch",
                        "program": "${file}",
                        "jit": true,
                        "optLevel": 3,
                        "args": [
                            "--jit",
                            "--jit-debug",
                            "-O3"
                        ],
                        "stopOnEntry": false
                    },
                    {
                        "name": "TzdLang: JIT 标准调试 (-O2)",
                        "type": "tzdlang",
                        "request": "launch",
                        "program": "${file}",
                        "jit": true,
                        "optLevel": 2,
                        "args": [
                            "--jit",
                            "--jit-debug",
                            "-O2"
                        ],
                        "stopOnEntry": false
                    },
                    {
                        "name": "TzdLang: 解释器逐行步进调试 (-O0 / 无JIT)",
                        "type": "tzdlang",
                        "request": "launch",
                        "program": "${file}",
                        "jit": false,
                        "optLevel": 0,
                        "args": [
                            "--no-jit"
                        ],
                        "stopOnEntry": false
                    },
                    {
                        "name": "TzdLang: CPU极限NTT大数调试",
                        "type": "tzdlang",
                        "request": "launch",
                        "program": "${file}",
                        "args": [
                            "--experimental-compute",
                            "--bigTime"
                        ],
                        "stopOnEntry": false
                    },
                    {
                        "name": "TzdLang: GPU加速NTT大数调试",
                        "type": "tzdlang",
                        "request": "launch",
                        "program": "${file}",
                        "args": [
                            "--forceGPU",
                            "--bigTime"
                        ],
                        "stopOnEntry": false
                    },
                    {
                        "name": "TzdLang: 附加到运行中服务 (Attach)",
                        "type": "tzdlang",
                        "request": "attach",
                        "debugHost": "127.0.0.1",
                        "debugPort": 54321
                    }
                ]
            },
            {
                "type": "tzd",
                "label": "Tzd (别名)",
                "languages": [
                    "tzdlang"
                ]
            }
        ],
        "commands": [
            {
                "command": "tzdlang.debugCurrentFile",
                "title": "TzdLang: 调试当前 Tzd 脚本 (F5)",
                "icon": "$(debug-alt)"
            },
            {
                "command": "tzdlang.runCurrentFile",
                "title": "TzdLang: 运行当前 Tzd 脚本 (Ctrl+F5)",
                "icon": "$(play)"
            },
            {
                "command": "tzdlang.resetToolsPath",
                "title": "TzdLang: 重新设置 TzdTools 路径"
            },
            {
                "command": "tzdlang.showJitStatus",
                "title": "TzdLang: 查看 JIT 引擎状态 (:jit status)"
            },
            {
                "command": "tzdlang.listJitFunctions",
                "title": "TzdLang: 列出已编译 JIT 函数与地址 (:jit list)"
            },
            {
                "command": "tzdlang.dumpJitIR",
                "title": "TzdLang: 导出函数 LLVM IR (:jit ir)"
            },
            {
                "command": "tzdlang.helloWorld",
                "title": "Hello World"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "tzdlang.debugCurrentFile",
                    "group": "navigation@1",
                    "when": "editorLangId == tzdlang"
                },
                {
                    "command": "tzdlang.runCurrentFile",
                    "group": "navigation@2",
                    "when": "editorLangId == tzdlang"
                }
            ]
        },
        "keybindings": [
            {
                "command": "tzdlang.debugCurrentFile",
                "key": "f5",
                "when": "editorLangId == tzdlang"
            },
            {
                "command": "tzdlang.runCurrentFile",
                "key": "ctrl+f5",
                "when": "editorLangId == tzdlang"
            }
        ],
        "configuration": {
            "title": "TzdLang",
            "properties": {
                "tzdlang.toolsPath": {
                    "type": "string",
                    "default": "",
                    "description": "TzdTools.exe 的完整路径。留空时扩展会自动在常见位置查找。"
                },
                "tzdlang.enableJit": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否默认启用 JIT 即时编译及极速执行。"
                },
                "tzdlang.optLevel": {
                    "type": "number",
                    "enum": [0, 1, 2, 3],
                    "default": 3,
                    "description": "默认 JIT 优化级别: 0 (无内联), 1 (轻度), 2 (标准平衡), 3 (极限内联与循环展开)。"
                },
                "tzdlang.enableAstInlining": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否默认开启 AST 级小函数极速内联。"
                }
            }
        }
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "vscode-test",
        "test:dap": "node test/dap_test.js",
        "test:main": "node test/dap_main_func_test.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.80.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.39.3"
    },
    "dependencies": {
        "antlr4": "^4.13.2",
        "vscode-languageclient": "^10.0.0",
        "vscode-languageserver": "^10.0.0",
        "vscode-languageserver-textdocument": "^1.0.13"
    }
}
