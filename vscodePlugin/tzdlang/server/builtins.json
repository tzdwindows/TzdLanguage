  "docs": {
    "print": {
      "signature": "print(...args: any) -> void",
      "summary": "向标准输出（控制台）打印一个或多个参数，不自动追加换行。",
      "params": [
        {
          "name": "args",
          "type": "...any",
          "desc": "要输出的变量、数值或表达式"
        }
      ],
      "returns": "void",
      "example": "print(\"Hello, \");\nprint(\"World!\\n\");"
    },
    "println": {
      "signature": "println(...args: any) -> void",
      "summary": "向标准输出（控制台）打印一个或多个参数，并在末尾追加换行符。",
      "params": [
        {
          "name": "args",
          "type": "...any",
          "desc": "要输出的变量、数值或表达式"
        }
      ],
      "returns": "void",
      "example": "println(\"Current count: \" + toString(count));"
    },
    "input": {
      "signature": "input(prompt?: string) -> string",
      "summary": "在控制台输出可选的提示文本，并阻塞等待用户从键盘输入一行字符串（支持 Unicode/中文输入）。",
      "params": [
        {
          "name": "prompt",
          "type": "string?",
          "desc": "可选的交互提示信息文本"
        }
      ],
      "returns": "string 包含用户键入内容的一整行文本（去除尾部换行）",
      "example": "var name = input(\"请输入你的名字: \");\nprint(\"你好, \" + name + \"\\n\");"
    },
    "len": {
      "signature": "len(target: string | array | map) -> int",
      "summary": "计算并返回目标对象的长度（字符串字符数、数组元素总数、或字典键值对总数）。",
      "params": [
        {
          "name": "target",
          "type": "string | array | map",
          "desc": "目标容器或字符串"
        }
      ],
      "returns": "int 元素数量或字符长度",
      "example": "var arr = [1, 2, 3, 4];\nprint(len(arr)); // 4\nprint(len(\"hello\")); // 5"
    },
    "range": {
      "signature": "range(start: int, stop: int, step: int = 1) -> array",
      "summary": "生成一个从 start 到 stop 步长为 step 的连续数值数组。JIT 针对此函数内置了 AVX2 内存流式直写和内存池零拷贝极致加速。",
      "params": [
        {
          "name": "start",
          "type": "int",
          "desc": "序列起始数值（包含）"
        },
        {
          "name": "stop",
          "type": "int",
          "desc": "序列终止边界数值（不包含）"
        },
        {
          "name": "step",
          "type": "int?",
          "desc": "序列增长步长，默认为 1，可为负数"
        }
      ],
      "returns": "array 数值数组",
      "example": "var r = range(0, 10, 2); // [0, 2, 4, 6, 8]\nvar primes = range(0, 1000000, 1);"
    },
    "type": {
      "signature": "type(val: any) -> string",
      "summary": "返回传入变量或表达式在运行时的底层类型名称字符串。",
      "params": [
        {
          "name": "val",
          "type": "any",
          "desc": "待检查的值"
        }
      ],
      "returns": "string 类型名称，如 \"int\", \"float\", \"string\", \"bool\", \"array\", \"map\", \"null\", \"class\" 等",
      "example": "print(type(42)); // \"int\"\nprint(type([1, 2])); // \"array\""
    },
    "assert": {
      "signature": "assert(condition: bool, message?: string) -> void",
      "summary": "断言传入的条件为真。如果条件为假，立即中断程序并抛出携带提示信息的断言异常。",
      "params": [
        {
          "name": "condition",
          "type": "bool",
          "desc": "必须满足的布尔条件"
        },
        {
          "name": "message",
          "type": "string?",
          "desc": "断言失败时输出的提示文本"
        }
      ],
      "returns": "void",
      "example": "assert(len(arr) > 0, \"数组不能为空！\");"
    },
    "assert_t": {
      "signature": "assert_t(condition: bool, message?: string) -> void",
      "summary": "断言测试辅助函数。条件为假时抛出运行时断言失败异常。",
      "params": [
        {
          "name": "condition",
          "type": "bool",
          "desc": "测试条件"
        },
        {
          "name": "message",
          "type": "string?",
          "desc": "失败信息"
        }
      ],
      "returns": "void",
      "example": "assert_t(x == 100, \"x 必须等于 100\");"
    },
    "clock": {
      "signature": "clock() -> float",
      "summary": "返回当前高精度硬件单调时钟时间戳（毫秒），常用于微基准性能测试与算法耗时统计。",
      "params": [],
      "returns": "float 毫秒级浮点时间戳",
      "example": "var t0 = clock();\n// 执行计算...\nprint(\"耗时: \" + toString(clock() - t0) + \" ms\");"
    },
