{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TzdLang",
  "scopeName": "source.tzdlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tzdlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tzdlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tzdlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.tzdlang", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.tzdlang",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.tzdlang", "match": "\\\\." }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tzdlang",
          "match": "\\b(if|else|while|for|break|continue|return|ret|switch|case|default|try|catch|throw|in)\\b"
        },
        {
          "name": "keyword.other.declaration.tzdlang",
          "match": "\\b(var|const|let|static|abstract|enum|class|extends|fun|native|import|new)\\b"
        },
        {
          "name": "keyword.other.special.tzdlang",
          "match": "\\b(print|printf|out)\\b"
        },
        {
          "name": "constant.language.tzdlang",
          "match": "\\b(true|false|null|super)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.tzdlang",
          "match": "\\b(int|float|string|bool|void|ptr|pointer|hwnd|function|fn)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tzdlang",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.tzdlang",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.tzdlang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.type.annotation.tzdlang",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.tzdlang",
          "match": "(\\+=|-=|\\*= |/=|\\b=\\b)"
        },
        {
          "name": "keyword.operator.comparison.tzdlang",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.logical.tzdlang",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.tzdlang",
          "match": "(\\+\\+|--|\\+|\\b-\\b|\\*|/|%|\\^)"
        }
      ]
    }
  }
}