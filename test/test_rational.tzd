// 分数运算测试
print("=== Rational (Fraction) Test ===");

// 1. 创建分数
var a = rational(1, 3);
print("1/3 = " + toString(a));

var b = rational(2, 3);
print("2/3 = " + toString(b));

// 2. 分数加法
var c = a + b;
print("1/3 + 2/3 = " + toString(c));

// 3. 分数减法
var d = a - b;
print("1/3 - 2/3 = " + toString(d));

// 4. 分数乘法
var e = a * b;
print("1/3 * 2/3 = " + toString(e));

// 5. 分数除法
var f = a / b;
print("1/3 / 2/3 = " + toString(f));

// 6. 分数与大数混合
var g = rational(1, 999999999999999999999);
print("1/999999999999999999999 = " + toString(g));

// 7. 分数约分
var h = rational(6, 4);
print("6/4 = " + toString(h));

// 8. 分数比较
print("1/3 < 2/3 = " + toString(a < b));
print("1/3 == 1/3 = " + toString(a == a));

// 9. toFraction
var tf = toFraction(0.5);
print("toFraction(0.5) = " + toString(tf));

// 10. 分数幂
var p = rational(2, 3);
var pe = p ^ 2;
print("(2/3)^2 = " + toString(pe));
