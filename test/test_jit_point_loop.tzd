class Point {
    var float x;
    var float y;
    Point(x, y) {
        this.x = x;
        this.y = y;
    }
    fun distance_sq(p) {
        var dx = this.x - p.x;
        var dy = this.y - p.y;
        ret dx * dx + dy * dy;
    }
}
fun testPointLoop() {
    var i = 0;
    while (i < 5) {
        var p1 = new Point(i, i);
        var p2 = new Point(i+1, i+1);
        var d = p1.distance_sq(p2);
        print("i: " + i + " d: " + d);
        i = i + 1;
    }
}
testPointLoop();
