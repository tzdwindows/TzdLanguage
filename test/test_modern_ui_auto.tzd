import "ui/Window.tzd";
import "ui/Control.tzd";
import "ui/App.tzd";

fun main() {
    print("=== TzdLang Modern UI Test ===");
    var win = new Window("TzdLang 现代风格 UI 演示与组件展示", 720, 560, 100, 100);
    win.setBackgroundColor(245, 247, 250);

    // 1. 顶部现代化选项卡 TabControl
    var tab = win.addTabControl(20, 15, 665, 32);
    tab.addTab("🌟 综合仪表盘", 0);
    tab.addTab("⚙️ 引擎配置", 1);
    tab.addTab("📊 统计监控", 2);
    tab.setSelectedIndex(0);

    // 2. 左侧分组框：基础与输入控件
    var gbBasic = win.addGroupBox(" 基础输入与状态 ", 20, 60, 310, 210);
    var lblUser = win.addLabel("用户名:", 35, 90, 60, 24);
    var txtUser = win.addTextBox("TzdArchitect", 100, 87, 210, 26, false);

    var chkHardware = win.addCheckBox("启用硬件 GPU 加速", 35, 125, 200, 24);
    chkHardware.setChecked(true);

    var radLight = win.addRadioButton("现代浅色主题", 35, 160, 120, 24);
    radLight.setChecked(true);
    var radDark = win.addRadioButton("极客深色模式", 170, 160, 120, 24);

    var btnApply = win.addButton("应用设置", 35, 200, 100, 32);

    // 3. 右侧分组框：高级控件与预览 (包含 DateTimePicker 与 GDI+ ImageView)
    var gbAdvance = win.addGroupBox(" 高级控件与图形预览 ", 350, 60, 335, 210);
    var lblDate = win.addLabel("日期选择:", 365, 90, 75, 24);
    var dtp = win.addDateTimePicker(445, 87, 225, 26, false);

    var lblImg = win.addLabel("3D 渲染视图:", 365, 125, 80, 24);
    var imgView = win.addImageView(445, 125, 225, 130, "screenshots/gl_render_test.png");

    // 4. 下方分组框：进度条与滑块联动测试 (重点验证 +10% 功能)
    var gbProgress = win.addGroupBox(" 进度与调节滑块联动 ", 20, 285, 665, 175);

    var lblSlider = win.addLabel("音量/调节 (滑块): 50%", 40, 315, 250, 24);
    var slider = win.addSlider(40, 345, 420, 35, 0, 100);
    slider.setValue(50);

    var lblProgress = win.addLabel("任务执行进度: 50%", 40, 390, 250, 24);
    var pbar = win.addProgressBar(40, 420, 420, 26, 0, 100);
    pbar.setProgress(50);

    slider.onChange(fun(h) {
        var v = slider.getValue();
        lblSlider.setText("音量/调节 (滑块): " + v + "%");
        pbar.setProgress(v);
        lblProgress.setText("任务执行进度: " + v + "%");
    });

    var btnStep = win.addButton("进度 +10%", 480, 417, 100, 32);
    btnStep.onClick(fun(h) {
        var cur = pbar.getProgress();
        print("[Event] 当前进度读取值: " + cur);
        if (cur >= 100) cur = 0; else cur = cur + 10;
        pbar.setProgress(cur);
        slider.setValue(cur);
        lblProgress.setText("任务执行进度: " + cur + "%");
        lblSlider.setText("音量/调节 (滑块): " + cur + "%");
        print("[Event] 进度更新后值: " + cur);
    });

    // 5. 底部状态栏 StatusBar
    var sb = win.addStatusBar();
    sb.setText("就绪 | TzdLang 现代 Win32 UI 引擎 | ComCtl32 v6 视觉样式已启用", 0);

    win.show();

    // 自动化测试验证: 模拟点击 +10% 并验证 getProgress()
    print("[Test] 初始进度值: " + pbar.getProgress());
    var v1 = pbar.getProgress();
    var next1 = v1 + 10;
    pbar.setProgress(next1);
    slider.setValue(next1);
    lblProgress.setText("任务执行进度: " + next1 + "%");
    print("[Test] 第一次 +10% 后的进度读取值: " + pbar.getProgress());

    var v2 = pbar.getProgress();
    var next2 = v2 + 10;
    pbar.setProgress(next2);
    slider.setValue(next2);
    lblProgress.setText("任务执行进度: " + next2 + "%");
    print("[Test] 第二次 +10% 后的进度读取值: " + pbar.getProgress());

    // 截屏保存验证
    App.pollEvents();
    win.saveScreenshot("screenshots/ui_modern_showcase.png");
    print("[Test] 现代 UI 界面截图已成功保存到 screenshots/ui_modern_showcase.png");

    // 保持循环一段时间供观察
    for (var i = 0; i < 30; i = i + 1) {
        App.pollEvents();
        App.sleep(20);
    }

    win.close();
    print("=== UI 测试全部通过 ===");
}
