print("");
print("========================================");
print("PyTorch Deep Test Results:");
print("  Passed: " + toString(passCount));
print("  Failed: " + toString(failCount));
print("  Total:  " + toString(passCount + failCount));
if (failCount == 0) {
    print("  *** ALL TESTS PASSED ***");
} else {
    print("  *** SOME TESTS FAILED ***");
}
