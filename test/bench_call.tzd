// bench_call.tzd - Isolate function call overhead
fun noop(x) { return x + 1; }

fun main() {
    // Small test first
    var t1 = clock();
    var s = 0;
    var i = 0;
    while (i < 100000) { s = noop(s); i = i + 1; }
    var t2 = clock();
    print("callOverhead(100k)=" + toString(s) + "  time=" + toString((t2-t1)/1000.0) + "s");

    // 1M test
    var t3 = clock();
    s = 0;
    i = 0;
    while (i < 1000000) { s = noop(s); i = i + 1; }
    var t4 = clock();
    print("callOverhead(1M)=" + toString(s) + "  time=" + toString((t4-t3)/1000.0) + "s");
}
