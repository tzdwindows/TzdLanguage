// bench_arith.tzd - Pure arithmetic benchmark
fun fib(n) {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

fun sumLoop(n) {
    var s = 0;
    var i = 0;
    while (i < n) {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fun main() {
    var t1 = clock();
    var f = fib(30);
    var t2 = clock();
    print("fib(30)=" + toString(f) + "  time=" + toString((t2 - t1) / 1000.0) + "s");

    var t3 = clock();
    var s = sumLoop(1000000);
    var t4 = clock();
    print("sum(1M)=" + toString(s) + "  time=" + toString((t4 - t3) / 1000.0) + "s");
}
