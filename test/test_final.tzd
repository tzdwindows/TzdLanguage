fun factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

fun fib(n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

class Point {
    var float x;
    var float y;
    Point(x, y) { this.x = x; this.y = y; }
    fun distSq(p) {
        var dx = this.x - p.x;
        var dy = this.y - p.y;
        return dx * dx + dy * dy;
    }
}

class Counter {
    var int count;
    Counter() { this.count = 0; }
    fun recurse(n) {
        if (n <= 0) { return this.count; }
        this.count = this.count + 1;
        return this.recurse(n - 1);
    }
}

print("=== FINAL VERIFICATION ===");

print("[1] factorial(10) = " + toString(factorial(10)));
print("[2] factorial(15) = " + toString(factorial(15)));
print("[3] fib(15) = " + toString(fib(15)));
