var p2 = new Point(3.0, 4.0);
print("[5] Point distSq = " + toString(p1.distSq(p2)));

var c = new Counter();
print("[6] Counter recurse(50) = " + toString(c.recurse(50)));
var c2 = new Counter();
print("[7] Counter recurse(100) = " + toString(c2.recurse(100)));

