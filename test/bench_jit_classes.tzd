// ============================================================================
// bench_jit_classes.tzd - Benchmark JIT class method performance
// Tests: class instantiation, method calls, field access, recursion
// ============================================================================

class Point {
    var float x;
    var float y;

    Point(x, y) {
        this.x = x;
        this.y = y;
    }

    fun distanceSq(other) {
        var dx = this.x - other.x;
        var dy = this.y - other.y;
        return dx * dx + dy * dy;
    }

    fun move(dx, dy) {
        this.x = this.x + dx;
        this.y = this.y + dy;
        return this;
    }

    fun clone() {
        return new Point(this.x, this.y);
    }
}

// Benchmark 1: Object creation
print("=== Benchmark 1: Object Creation ===");
var n = 100000;
var start = clock();
for (i = 0; i < n; i = i + 1) {
    var p = new Point(i * 0.001, i * 0.002);
}
var elapsed = clock() - start;
print("Created " + toString(n) + " objects in " + toString(elapsed) + " ms");
print("Rate: " + toFixed(n / (elapsed / 1000.0), 0) + " objects/sec");
print("");

// Benchmark 2: Method calls
print("=== Benchmark 2: Method Calls ===");
var p1 = new Point(0.0, 0.0);
var p2 = new Point(3.0, 4.0);
start = clock();
var sum = 0.0;
for (i = 0; i < n; i = i + 1) {
    sum = sum + p1.distanceSq(p2);
}
elapsed = clock() - start;
print("Called distanceSq " + toString(n) + " times in " + toString(elapsed) + " ms");
print("Result: " + toString(sum));
print("Rate: " + toFixed(n / (elapsed / 1000.0), 0) + " calls/sec");
print("");

// Benchmark 3: Field access (JIT native indexed access)
print("=== Benchmark 3: Field Access ===");
var p = new Point(1.0, 2.0);
start = clock();
var total = 0.0;
for (i = 0; i < n; i = i + 1) {
    total = total + p.x + p.y;
}
elapsed = clock() - start;
print("Field access x " + toString(n * 2) + " in " + toString(elapsed) + " ms");
print("Rate: " + toFixed(n * 2 / (elapsed / 1000.0), 0) + " accesses/sec");
print("");

// Benchmark 4: Recursive class method
print("=== Benchmark 4: Recursive Class Method ===");
class Accumulator {
    var float total;

    Accumulator() { this.total = 0.0; }

    fun addRec(n) {
        if (n <= 0) { return this.total; }
        this.total = this.total + n;
        return this.addRec(n - 1);
    }
}

var acc = new Accumulator();
start = clock();
var result = acc.addRec(1000);
elapsed = clock() - start;
print("Recursive method (1000 deep) in " + toString(elapsed) + " ms, result=" + toString(result));
print("");

// Benchmark 5: Pure function vs class method
print("=== Benchmark 5: Function vs Method ===");
fun freeDistanceSq(x1, y1, x2, y2) {
    var dx = x1 - x2;
    var dy = y1 - y2;
    return dx * dx + dy * dy;
}

start = clock();
var sum2 = 0.0;
for (i = 0; i < n; i = i + 1) {
    sum2 = sum2 + freeDistanceSq(0.0, 0.0, 3.0, 4.0);
}
elapsed = clock() - start;
print("Free function: " + toString(elapsed) + " ms");

start = clock();
var sum3 = 0.0;
for (i = 0; i < n; i = i + 1) {
    sum3 = sum3 + p1.distanceSq(p2);
}
elapsed = clock() - start;
print("Class method: " + toString(elapsed) + " ms");
print("");

// Benchmark 6: Numeric loop (JIT native double)
print("=== Benchmark 6: Numeric Loop ===");
start = clock();
var s = 0.0;
for (i = 0; i < 1000000; i = i + 1) {
    s = s + i * 0.001;
}
elapsed = clock() - start;
print("1M iterations in " + toString(elapsed) + " ms, sum=" + toString(s));
print("Rate: " + toFixed(1000000 / (elapsed / 1000.0), 0) + " iter/sec");
print("");

print("=== Benchmark Complete ===");
exit;
