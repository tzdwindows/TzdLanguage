// bench_obj_small.tzd - Quick object test
class Point {
    var float x;
    var float y;
    Point(x, y) { this.x = x; this.y = y; }
}

fun main() {
    print("=== Small Object Test ===");
    var t1 = clock();
    var s = 0.0;
    var i = 0;
    while (i < 500) { var p = new Point(i * 1.0, i * 2.0); s = s + p.x; i = i + 1; }
    var t2 = clock();
    print("create(500)=" + toString(s) + " time=" + toString((t2-t1)) + "ms");
}
