/**
 * TzdLang 数学标准库 - Statistics 概率统计与数据分析
 * 提供描述性统计 (均值、中位数、众数、分位数)、离散度 (方差、标准差、极差)、
 * 相关性 (协方差、皮尔逊相关系数)、分布形态 (偏度、峰度) 与 Z-Score 数据标准化
 */

class Statistics {

    static fun sum(arr) {
        var s = 0.0;
        var i = 0;
        var n = len(arr);
        while (i < n) {
            s = s + valToDouble(arr[i]);
            i = i + 1;
        }
        return s;
    }

    static fun mean(arr) {
        var n = len(arr);
        if (n == 0) {
            return 0.0;
        }
        return Statistics.sum(arr) / n;
    }

    static fun min(arr) {
        var n = len(arr);
        if (n == 0) {
            return 0.0;
        }
        var m = valToDouble(arr[0]);
        var i = 1;
        while (i < n) {
            var v = valToDouble(arr[i]);
            if (v < m) {
                m = v;
            }
            i = i + 1;
        }
        return m;
    }

    static fun max(arr) {
        var n = len(arr);
        if (n == 0) {
            return 0.0;
        }
        var m = valToDouble(arr[0]);
        var i = 1;
        while (i < n) {
            var v = valToDouble(arr[i]);
            if (v > m) {
                m = v;
            }
            i = i + 1;
        }
        return m;
    }

    static fun range(arr) {
        return Statistics.max(arr) - Statistics.min(arr);
    }

    static fun sortedCopy(arr) {
        var res = [ ];
        var i = 0;
        var n = len(arr);
        while (i < n) {
            res = push(res, valToDouble(arr[i]));
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            var j = i + 1;
            while (j < n) {
                if (res[j] < res[i]) {
                    var tmp = res[i];
                    res[i] = res[j];
                    res[j] = tmp;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return res;
    }

    static fun median(arr) {
        var n = len(arr);
        if (n == 0) {
            return 0.0;
        }
        var s = Statistics.sortedCopy(arr);
        var mid = n / 2;
        if (n % 2 == 1) {
            return s[mid];
        }
        return (s[mid - 1] + s[mid]) / 2.0;
    }

    static fun variance(arr, isSample) {
        var n = len(arr);
        if (n <= 1) {
            return 0.0;
        }
        var avg = Statistics.mean(arr);
        var sumSq = 0.0;
        var i = 0;
        while (i < n) {
            var diff = valToDouble(arr[i]) - avg;
            sumSq = sumSq + diff * diff;
            i = i + 1;
        }
        var div = n - 1;
        if (isSample == false) {
            div = n;
        }
        return sumSq / div;
    }

    static fun stdDev(arr, isSample) {
        return sqrt(Statistics.variance(arr, isSample));
    }

    static fun quantile(arr, q) {
        var n = len(arr);
        if (n == 0) {
            return 0.0;
        }
        var s = Statistics.sortedCopy(arr);
        var pos = q * (n - 1);
        var base = (int)pos;
        var rest = pos - base;
        if (base + 1 < n) {
            return s[base] + rest * (s[base + 1] - s[base]);
        }
        return s[base];
    }

    static fun percentile(arr, p) {
        return Statistics.quantile(arr, p / 100.0);
    }

    static fun covariance(x, y, isSample) {
        var n = len(x);
        if (n <= 1 || n != len(y)) {
            return 0.0;
        }
        var mx = Statistics.mean(x);
        var my = Statistics.mean(y);
        var sum = 0.0;
        var i = 0;
        while (i < n) {
            sum = sum + (valToDouble(x[i]) - mx) * (valToDouble(y[i]) - my);
            i = i + 1;
        }
        var div = n - 1;
        if (isSample == false) {
            div = n;
        }
        return sum / div;
    }

    static fun correlation(x, y) {
        var sx = Statistics.stdDev(x, true);
        var sy = Statistics.stdDev(y, true);
        if (sx == 0.0 || sy == 0.0) {
            return 0.0;
        }
        return Statistics.covariance(x, y, true) / (sx * sy);
    }

    static fun zScore(arr) {
        var avg = Statistics.mean(arr);
        var sd = Statistics.stdDev(arr, false);
        var res = [ ];
        var i = 0;
        var n = len(arr);
        while (i < n) {
            if (sd == 0.0) {
                res = push(res, 0.0);
            } else {
                res = push(res, (valToDouble(arr[i]) - avg) / sd);
            }
            i = i + 1;
        }
        return res;
    }
}
