import "torch/RNN.tzd";          // 5. RNN / LSTM / GRU Networks
import "torch/Transformer.tzd";  // 6. FlashAttention & Multi-Head Attention
import "torch/Parallel.tzd";     // 7. Model Parallelism & Pipeline
import "torch/Symbolic.tzd";     // 8. Dynamic Shapes & FX Graphs
import "torch/Sparse.tzd";       // 9. Sparse Tensors (COO / CSR)
import "torch/GNN.tzd";          // 10. Graph Neural Networks
import "torch/RL.tzd";           // 11. Reinforcement Learning
import "torch/Export.tzd";       // 12. ONNX & Edge Model Export
import "torch/Compile.tzd";      // 13. Compilation & Operator Fusion
import "torch/AMP.tzd";          // 14. Automatic Mixed Precision & Memory
import "torch/Data.tzd";         // 15. Dataset & DataLoader
import "torch/Profiler.tzd";     // 15. Performance Profiler
import "torch/SummaryWriter.tzd";// 15. TensorBoard Integration
