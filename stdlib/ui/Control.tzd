class TabControl extends Control {
    TabControl(h) {
        super(h);
    }

    fun addTab(title, index) {
        if (this.handle != null) {
            return ui_tab_add(this.handle, title, index);
        }
        return -1;
    }

    fun getSelectedIndex() {
        if (this.handle != null) {
            return ui_tab_get_cur_sel(this.handle);
        }
        return -1;
    }

    fun setSelectedIndex(index) {
        if (this.handle != null) {
            ui_tab_set_cur_sel(this.handle, index);
        }
        return this;
    }

    fun onChange(callback) {
        if (this.handle != null && callback != null) {
            ui_on_change(this.handle, callback);
        }
        return this;
    }
}

class DateTimePicker extends Control {
    DateTimePicker(h) {
        super(h);
    }

    fun getDateTime() {
        if (this.handle != null) {
            return ui_get_datetime(this.handle);
        }
        return "";
    }

    fun setDateTime(year, month, day, hour, minute, second) {
        if (this.handle != null) {
            ui_set_datetime(this.handle, year, month, day, hour, minute, second);
        }
        return this;
    }

    fun onChange(callback) {
        if (this.handle != null && callback != null) {
            ui_on_change(this.handle, callback);
        }
        return this;
    }
}

class StatusBar extends Control {
    StatusBar(h) {
        super(h);
    }

    fun setText(text, part) {
        if (this.handle != null) {
            var p = 0;
            if (part != null) p = part;
            ui_set_statusbar_text(this.handle, text, p);
        }
        return this;
    }
}

class ImageView extends Control {
    ImageView(h) {
        super(h);
    }

    fun setImage(path) {
        if (this.handle != null) {
            ui_set_image(this.handle, path);
        }
        return this;
    }
}
