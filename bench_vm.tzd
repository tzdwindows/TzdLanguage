// bench_vm.tzd - Benchmark bytecode VM vs interpreter
var N = 50000;

fun fib(n) {
    if (n <= 1) { return n; }
    return fib(n - 1) + fib(n - 2);
}

fun sumLoop(n) {
    var s = 0;
    for (i = 0; i < n; i = i + 1) {
        s = s + i;
    }
    return s;
}

print("=== Benchmark ===");

var t0 = clock();
var fibResult = fib(25);
var t1 = clock();
print("fib(25) = " + toString(fibResult) + " in " + toString(t1 - t0) + "ms");

var t2 = clock();
var loopResult = sumLoop(N);
var t3 = clock();
print("sumLoop(" + toString(N) + ") = " + toString(loopResult) + " in " + toString(t3 - t2) + "ms");

print("=== Done ===");
