fun factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

fun fib(n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

class Point {
    var float x;
    var float y;

    Point(x, y) {
        this.x = x;
        this.y = y;
    }

    fun distanceSq(other) {
        var dx = this.x - other.x;
        var dy = this.y - other.y;
        return dx * dx + dy * dy;
    }
}

print("=== JIT Test Results ===");
print("factorial(10) = " + toString(factorial(10)));
print("factorial(20) = " + toString(factorial(20)));
print("fib(30) = " + toString(fib(30)));

var p1 = new Point(0.0, 0.0);
var p2 = new Point(3.0, 4.0);
var dist = p1.distanceSq(p2);
print("Point distanceSq = " + toString(dist));

var start = clock();
var sum = 0.0;
for (i = 0; i < 1000000; i = i + 1) {
    sum = sum + i * 0.001;
}
var elapsed = clock() - start;
print("1M loop in " + toString(elapsed) + " ms, sum=" + toString(sum));

start = clock();
var s = 0.0;
for (i = 0; i < 100000; i = i + 1) {
    s = s + p1.distanceSq(p2);
}
elapsed = clock() - start;
print("100K method calls in " + toString(elapsed) + " ms");

print("=== All JIT tests passed! ===");
exit;
